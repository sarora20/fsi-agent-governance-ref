            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "agent-actor",
      "description": "RFC 8693 act claim naming the agent. A default scope, not a client mapper: during a downscope-only exchange Keycloak drops client-level mappers",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
